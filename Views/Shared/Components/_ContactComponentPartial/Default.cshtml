```cshtml
@model List<MyPortfolioUdemy.DAL.Entities.Contact>

<section id="contact" class="s-contact target-section">

    <div class="overlay"></div>

    @foreach (var item in Model)
    {
        <div class="row narrow section-intro">
            <div class="col-full">
                <h3>İletişim</h3>
                <h1>@item.Title</h1>

                <p class="lead">@item.Description</p>
            </div>
        </div>

        <div class="row contact__main">
            <div class="col-eight tab-full contact__form">
                <form name="contactForm" id="contactForm" method="post" action="">
                    <fieldset>

                        <div class="form-field">
                            <input name="contactName" type="text" id="contactName" placeholder="Adınız Soyadınız" value="" minlength="2" required="" aria-required="true" class="full-width">
                        </div>

                        <div class="form-field">
                            <input name="contactEmail" type="email" id="contactEmail" placeholder="E-posta Adresiniz" value="" required="" aria-required="true" class="full-width">
                        </div>

                        <div class="form-field">
                            <input name="contactSubject" type="text" id="contactSubject" placeholder="Konu" value="" class="full-width">
                        </div>

                        <div class="form-field">
                            <textarea name="contactMessage" id="contactMessage" placeholder="Mesajınız" rows="10" cols="50" required="" aria-required="true" class="full-width"></textarea>
                        </div>

                        <div class="form-field">
                            <button class="full-width btn--primary">Mesaj Gönder</button>
                            <div class="submit-loader">
                                <div class="text-loader">Gönderiliyor...</div>
                                <div class="s-loader">
                                    <div class="bounce1"></div>
                                    <div class="bounce2"></div>
                                    <div class="bounce3"></div>
                                </div>
                            </div>
                        </div>

                    </fieldset>
                </form>

                <!-- contact-warning -->
                <div class="message-warning">
                    Bir hata oluştu. Lütfen tekrar deneyin.
                </div>

                <!-- contact-success -->
                <div class="message-success">
                    Mesajınız başarıyla gönderildi. Teşekkür ederim!
                </div>

            </div>

            <div class="col-four tab-full contact__infos">

                <h4 class="h06">Telefon</h4>
                <p>
                    <a href="tel:@item.Phone1">@item.Phone1</a><br>
                    <a href="tel:@item.Phone2">@item.Phone2</a>
                </p>

                <h4 class="h06">E-posta</h4>
                <p>
                    <a href="mailto:@item.Email1">@item.Email1</a><br>
                    <a href="mailto:@item.Email2">@item.Email2</a>
                </p>

                <h4 class="h06">Adres</h4>
                <p>
                    @item.Address
                </p>

            </div>

        </div>
    }

</section> <!-- end s-contact -->
```